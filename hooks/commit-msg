#!/usr/bin/env bash
# Enforces Conventional Commit format on every commit.
# Installed into consumer projects by scripts/install-hooks.sh.
#
# Format: <type>[optional scope]: <description>
# Types:  feat | fix | chore | docs | refactor | test | style | perf | build | ci
#
# See: https://www.conventionalcommits.org

set -euo pipefail

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Allow merge commits, revert commits, and fixup/squash (interactive rebase)
if echo "$MSG" | grep -qE "^(Merge |Revert |fixup! |squash! )"; then
  exit 0
fi

# No Co-Authored-By trailer — commits are not attributed to AI coding agents.
if echo "$MSG" | grep -qiE "^Co-Authored-By:"; then
  echo "" >&2
  echo "  ❌  Commit rejected — no Co-Authored-By trailer." >&2
  echo "  Remove the trailer line and re-commit." >&2
  echo "" >&2
  exit 1
fi

# Conventional Commit pattern
PATTERN="^(feat|fix|chore|docs|refactor|test|style|perf|build|ci)(\([a-z0-9][a-z0-9 _-]*\))?: .{3,}"

FIRST_LINE=$(echo "$MSG" | head -1)

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo "" >&2
  echo "  ❌  Commit rejected — message does not follow Conventional Commit format." >&2
  echo "" >&2
  echo "  Format:  <type>[optional scope]: <description>" >&2
  echo "  Types:   feat | fix | chore | docs | refactor | test | style | perf | build | ci" >&2
  echo "" >&2
  echo "  Examples:" >&2
  echo "    feat(auth): add biometric login" >&2
  echo "    fix: correct KSP version in feature-scaffold" >&2
  echo "    chore(deps): bump ktor 3.1.3 → 3.5.0" >&2
  echo "    docs: update architecture diagram" >&2
  echo "" >&2
  echo "  Your message: $FIRST_LINE" >&2
  echo "" >&2
  exit 1
fi

# Reject low-entropy / micro-commit descriptions
if echo "$FIRST_LINE" | grep -qiE "^(feat|fix|chore|docs|refactor|test|style|perf|build|ci)(\([a-z0-9][a-z0-9 _-]*\))?:\s*(wip|temp|fix|minor|update|test|tests|changes|clean|trying|debug|work|done|typo|fix typo)\.?$"; then
  echo "" >&2
  echo "  ❌  Commit rejected — low-entropy / micro-commit description." >&2
  echo "" >&2
  echo "  Provide a descriptive message stating what was changed (e.g. 'fix: handle null token in auth')." >&2
  echo "  If fixing a small issue in an unpushed commit, amend instead: git commit --amend --no-edit" >&2
  echo "" >&2
  exit 1
fi

exit 0
