#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2023-2026 Ron June Valdoz
#
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# 1. Verify Copyright & SPDX headers on staged files (if tool exists)
if [ -f "$repo_root/tools/verify_copyright_headers.py" ]; then
  if ! python3 "$repo_root/tools/verify_copyright_headers.py" --staged; then
    echo "pre-commit hook: staged first-party source is missing required copyright/SPDX header." >&2
    exit 1
  fi
fi

# 2. Secret & Token Scanner (gitleaks)
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --redact --staged --no-banner; then
    echo "pre-commit hook: gitleaks found a likely secret in staged changes." >&2
    echo "Remove it, or add a verified false positive to .gitleaks.toml." >&2
    exit 1
  fi
fi

# 3. Large Binary File Guard (> 15MB check)
max_bytes=15728640
large_files=$(git diff --cached --name-only | while read -r f; do
  if [ -f "$f" ]; then
    size=$(wc -c < "$f" | tr -d ' ')
    if [ "$size" -gt "$max_bytes" ]; then
      echo "$f ($(( size / 1048576 ))MB)"
    fi
  fi
done)

if [ -n "$large_files" ]; then
  echo "pre-commit hook: staged file exceeds 15MB size limit (use Git LFS or external assets):" >&2
  echo "$large_files" >&2
  exit 1
fi

# 4. Lesson Harvesting Reminder
if git diff --cached --name-only | grep -q "^docs/lessons/"; then
  echo "💡 [kmp-agent-skills] New lesson staged! Run '/kmp-harvest-lessons' when ready to upstream patterns."
fi

# 5. Tech Debt & Orphan Comment Guard (checks newly added TODOs)
raw_todos=$(git diff --cached -U0 | grep -E '^\+\s*//\s*(TODO|FIXME)' | grep -vE '#[0-9]+|\([A-Za-z0-9_-]+-[0-9]+\)' || true)
if [ -n "$raw_todos" ]; then
  echo "💡 [tech-debt] Staged untracked TODO without ticket reference (e.g. // TODO(#123): ...):"
  echo "$raw_todos" | head -n 3 | sed 's/^+/  /'
  echo "  Tip: Link to an issue or park in docs/audits/ to prevent tech debt drift."
fi

# 6. Self-Healing Docs Sitemap & Tasks Index (if docs/ was modified)
if git diff --cached --name-only | grep -q "^docs/.*\.md$"; then
  heal_script=""
  if [ -f "$repo_root/.agents/skills/kmp-project-docs-maintainer/scripts/heal_docs.py" ]; then
    heal_script="$repo_root/.agents/skills/kmp-project-docs-maintainer/scripts/heal_docs.py"
  elif [ -f "$repo_root/skills/kmp-project-docs-maintainer/scripts/heal_docs.py" ]; then
    heal_script="$repo_root/skills/kmp-project-docs-maintainer/scripts/heal_docs.py"
  elif [ -f "$repo_root/scripts/heal_docs.py" ]; then
    heal_script="$repo_root/scripts/heal_docs.py"
  fi
  if [ -n "$heal_script" ]; then
    python3 "$heal_script" --project "$repo_root" >/dev/null 2>&1 || true
    if [ -f "$repo_root/docs/README.md" ]; then
      git add "$repo_root/docs/README.md"
    fi
    if [ -f "$repo_root/docs/tasks.md" ]; then
      git add "$repo_root/docs/tasks.md"
    fi
  fi
fi

# 6b. Docs Hygiene Enforcement (checks for scattered tasks, rogue dirs, misplaced assets)
if git diff --cached --name-only | grep -q "^docs/"; then
  audit_script=""
  if [ -f "$repo_root/.agents/skills/kmp-audit/scripts/audit_skills_repo.py" ]; then
    audit_script="$repo_root/.agents/skills/kmp-audit/scripts/audit_skills_repo.py"
  elif [ -f "$repo_root/skills/kmp-audit/scripts/audit_skills_repo.py" ]; then
    audit_script="$repo_root/skills/kmp-audit/scripts/audit_skills_repo.py"
  fi
  if [ -n "$audit_script" ] && [ -d "$repo_root/docs" ]; then
    if ! python3 "$audit_script" "$repo_root" --docs-hygiene-only; then
      echo "pre-commit hook: docs hygiene violation detected! Run 'python3 $audit_script $repo_root --docs-hygiene-only' for details." >&2
      exit 1
    fi
  fi
fi

# 7. Lightweight Architecture Smell Scan (if hook script exists)
if [ -f "$repo_root/hooks/pre-commit-audit.sh" ]; then
  exec "$repo_root/hooks/pre-commit-audit.sh"
fi

